{
  "name": "auda",
  "version": "0.1.0",
  "private": true,
  "description": "AUDA — an always-on autonomous digital operator.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/src/bin/auda.ts",
    "start:core": "NODE_ENV=production tsx server/src/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test server/test/*.test.ts",
    "e2e": "node scripts/e2e.mjs && node scripts/e2e-agent.mjs && node scripts/e2e-reliability.mjs && node scripts/e2e-lan.mjs && node scripts/e2e-org.mjs && node scripts/e2e-office.mjs && node scripts/e2e-lmstudio.mjs",
    "e2e:lan": "node scripts/e2e-lan.mjs",
    "e2e:org": "node scripts/e2e-org.mjs",
    "e2e:office": "node scripts/e2e-office.mjs",
    "e2e:lmstudio": "node scripts/e2e-lmstudio.mjs",
    "e2e:slice": "node scripts/e2e.mjs",
    "e2e:agent": "node scripts/e2e-agent.mjs",
    "e2e:reliability": "node scripts/e2e-reliability.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bonjour-service": "^1.4.4",
    "docx": "^9.8.1",
    "exceljs": "^4.4.0",
    "marked": "^16.4.2",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
